<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="https://moise-lang.github.io/xml/os.xsl" type="text/xsl" ?>
<organisational-specification
    id="evds"
    os-version="1.1"
    xmlns='http://moise.sourceforge.net/os'
    xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:schemaLocation='http://moise.sourceforge.net/os
                        https://moise-lang.github.io/xml/os.xsd' >

<!--
  EVDS organisational specification.

  One group (dispatchGroup) with six roles. "responder" is an abstract
  role, specialised by ambulance_role / firetruck_role / police_role, so
  the normative-specification only has to state the obligation once
  (role="responder") and it applies to all three vehicle kinds.

  One parametrised scheme (incidentResponseScheme) drives the whole
  lifecycle of a single incident: allocateVehicle (dispatcher's job),
  then respondOnScene and closeIncident (assigned responder's job), in
  that order, each with a deadline (ttf = time-to-fulfil). Deadlines are
  what let the normative dimension actually do something useful: when
  allocateVehicle is not achieved in time, the organisation raises an
  oblUnfulfilled event that supervisor1 listens for (see supervisor.asl)
  to trigger the decentralised fallback protocol.
-->

<structural-specification>

  <role-definitions>
    <role id="dispatcher" />
    <role id="responder" />
    <role id="ambulance_role"> <extends role="responder"/> </role>
    <role id="firetruck_role"> <extends role="responder"/> </role>
    <role id="police_role">    <extends role="responder"/> </role>
    <role id="hospital_role" />
    <role id="supervisor_role" />
  </role-definitions>

  <group-specification id="dispatchGroup">
    <roles>
      <role id="dispatcher"      min="1" max="2"/>
      <role id="ambulance_role"  min="0" max="10"/>
      <role id="firetruck_role"  min="0" max="10"/>
      <role id="police_role"     min="0" max="10"/>
      <role id="hospital_role"   min="1" max="5"/>
      <role id="supervisor_role" min="0" max="2"/>
    </roles>
  </group-specification>

</structural-specification>

<functional-specification>
  <scheme id="incidentResponseScheme">
    <goal id="handleIncident">
      <argument id="IncId"/>
      <argument id="Type"/>
      <argument id="Loc"/>
      <argument id="Sev"/>
      <plan operator="sequence">
        <goal id="allocateVehicle" ttf="20 seconds" />
        <goal id="respondOnScene"  ttf="6 minutes" />
        <goal id="closeIncident"   ttf="4 minutes" />
      </plan>
    </goal>

    <mission id="mDispatch" min="1" max="1">
      <goal id="allocateVehicle" />
    </mission>
    <mission id="mRespond" min="0" max="1">
      <goal id="respondOnScene" />
      <goal id="closeIncident" />
    </mission>
  </scheme>
</functional-specification>

<normative-specification>

  <norm id="n1"
        type="obligation"
        role="dispatcher"
        mission="mDispatch" />

  <!-- A winning responder must be permitted to join mRespond.
       Do not make this an obligation: otherwise every idle responder
       can auto-commit and violate mRespond's max="1" cardinality. -->
  <norm id="pAmbulanceRespond"
        type="permission"
        role="ambulance_role"
        mission="mRespond" />

  <norm id="pFiretruckRespond"
        type="permission"
        role="firetruck_role"
        mission="mRespond" />

  <norm id="pPoliceRespond"
        type="permission"
        role="police_role"
        mission="mRespond" />

  <!-- Keep your existing explanatory comment and the rest of the
       normative specification below this point. -->
  <!--
    No norm on "responder"/mRespond, deliberately. org-obedient.asl (the
    standard obligation-handling template included by every org-aware
    agent) reacts to ANY obligation to commit to a mission by committing
    immediately and unconditionally: it has no notion of "wait for the
    Contract-Net winner to be told". With mRespond capped at max="1", an
    obligation on the whole "responder" role made every idle responder
    auto-commit the instant the goal was enabled, so multiple vehicles
    raced to fill the one slot: the loser(s) failed with
    mission_cardinality errors and were left running respondOnScene with
    no scheme arguments bound. Confirmed live against the real runtime,
    not theoretical. Mission selection here is deliberately kept outside
    the normative layer: dispatcher1 tells exactly one winning agent to
    commit (see joinIncident in common_responder.asl), so no norm is
    declared on this mission at all.
  -->
</normative-specification>

</organisational-specification>
