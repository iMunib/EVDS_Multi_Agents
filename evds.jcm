/*
    EVDS - Emergency Vehicle Dispatch System
    CST3118 Group Project - JaCaMo implementation

    This JCM file is the application's composition root. It connects:
      1. Jason agents and their AgentSpeak source files;
      2. CArtAgO workspaces and Java artifacts; and
      3. the Moise organisation, its group, roles, and players.

    Run from the project root with:
        .\gradlew clean run
*/

mas evds {

    // ================================================================
    // AGENT DIMENSION
    // ================================================================
    // "focus" makes an artifact's observable properties and operations
    // available to an agent. Workspace joins/focuses happen
    // asynchronously at startup, which is why AgentSpeak plans use the
    // ?joined(Name,Id) retry helper before workspace-specific actions.

    // Central dispatcher. It receives incident events from board,
    // accesses city ETA/coordinates through cityMap, and displays
    // incident markers through mapView.
    agent dispatcher1 : dispatcher.asl {
        focus: cityHub.cityMap
        focus: cityHub.board
        focus: cityHub.mapView
    }

    // Organisation monitor. It watches incident scheme boards for
    // deadline failures and triggers the peer-to-peer fallback protocol.
    agent supervisor1 : supervisor.asl

    // Medical responders. setupVehicle(Home) creates each unit's
    // VehicleArtifact and establishes its initial city-map node.
    agent amb1 : ambulance.asl {
        goals: setupVehicle("Station_North")
        focus: cityHub.cityMap
        focus: cityHub.board
        focus: stationNorth.fuelPumpN
    }
    agent amb2 : ambulance.asl {
        goals: setupVehicle("Station_North")
        focus: cityHub.cityMap
        focus: cityHub.board
        focus: stationNorth.fuelPumpN
    }
    agent amb3 : ambulance.asl {
        goals: setupVehicle("Station_South")
        focus: cityHub.cityMap
        focus: cityHub.board
        focus: stationSouth.fuelPumpS
    }

    // Fire responders.
    agent fire1 : firetruck.asl {
        goals: setupVehicle("Station_North")
        focus: cityHub.cityMap
        focus: cityHub.board
        focus: stationNorth.fuelPumpN
    }
    agent fire2 : firetruck.asl {
        goals: setupVehicle("Station_South")
        focus: cityHub.cityMap
        focus: cityHub.board
        focus: stationSouth.fuelPumpS
    }

    // Patrol responders.
    agent police1 : police.asl {
        goals: setupVehicle("Station_North")
        focus: cityHub.cityMap
        focus: cityHub.board
        focus: stationNorth.fuelPumpN
    }
    agent police2 : police.asl {
        goals: setupVehicle("Station_South")
        focus: cityHub.cityMap
        focus: cityHub.board
        focus: stationSouth.fuelPumpS
    }

    // Hospitals are agents, not merely artifacts: each creates its own
    // HospitalArtifact in cityHub and periodically discharges patients.
    agent hospital_general : hospital.asl {
        goals: setupHospital(12)
        focus: cityHub.board
    }
    agent hospital_stmarys : hospital.asl {
        goals: setupHospital(8)
        focus: cityHub.board
    }

    // Utility agents. They are deliberately outside the Moise response
    // roles because they generate/modify environment state only.
    agent incident_generator : incident_generator.asl {
        focus: cityHub.board
    }

    agent traffic_monitor : traffic_monitor.asl {
        focus: cityHub.cityMap
    }

    // ================================================================
    // ENVIRONMENT DIMENSION
    // ================================================================

    // Shared city workspace. All agents needing routing, incident board,
    // or GUI information join/focus artifacts in this workspace.
    workspace cityHub {
        artifact cityMap : evds.CityMapArtifact()
        artifact board   : evds.DispatchBoardArtifact()

        // The dispatcher owns the initial GUI focus. Responders look up
        // mapView explicitly during setupVehicle and push position updates.
        artifact mapView : evds.CityMapGUI() {
            focused-by: dispatcher1
        }
    }

    // Local station workspaces show environment partitioning. Each has
    // a limited shared fuel resource rather than placing all resources
    // in one global workspace.
    workspace stationNorth {
        artifact fuelPumpN : evds.FuelStationArtifact(2)
    }

    workspace stationSouth {
        artifact fuelPumpS : evds.FuelStationArtifact(2)
    }

    // ================================================================
    // ORGANISATION DIMENSION
    // ================================================================
    // evdsOrg loads the Moise OS from evds-os.xml. "players" assigns
    // actual Jason agents to the organisation's abstract roles.
    organisation evdsOrg : evds-os.xml {
        group dispatchGrp : dispatchGroup {
            players: dispatcher1      dispatcher
                     amb1             ambulance_role
                     amb2             ambulance_role
                     amb3             ambulance_role
                     fire1            firetruck_role
                     fire2            firetruck_role
                     police1          police_role
                     police2          police_role
                     hospital_general hospital_role
                     hospital_stmarys hospital_role
                     supervisor1      supervisor_role
        }
    }
}